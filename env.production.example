# =============================================================================
# VREMA – Production Environment Template
# Stand: Task 16 Repair-Mode. Bitte alle als REQUIRED markierten Variablen vor
# dem Deployment setzen, sonst bootet die App nicht oder Features fallen aus.
# =============================================================================

# ── Core App ────────────────────────────────────────────────────────────────
# REQUIRED
NODE_ENV=production
# REQUIRED – wird in Server-Actions, E-Mail-Links und SEO/Sitemap genutzt.
NEXT_PUBLIC_APP_URL=https://vrema.app
# REQUIRED – Prisma/Postgres Connection-String (sslmode=require empfohlen).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# Optional – kommaseparierte Liste zusätzlicher Server-Action-Origins
# (z.B. Staging-Subdomains). www./apex-Variante werden automatisch ergänzt.
NEXT_PUBLIC_ADDITIONAL_ALLOWED_ORIGINS=

# ── Auth.js (NextAuth) ──────────────────────────────────────────────────────
# REQUIRED – >= 64 Zeichen, kryptographisch sicher generieren (`openssl rand -hex 32`).
AUTH_SECRET=replace-with-long-random-secret
# REQUIRED – hinter Reverse-Proxy ("true"), sonst weglassen.
AUTH_TRUST_HOST=true
# REQUIRED – muss zu NEXT_PUBLIC_APP_URL passen.
AUTH_URL=https://vrema.app

# ── OAuth (optional) ────────────────────────────────────────────────────────
# Optional – Google-Login. Wenn leer, wird der Provider gar nicht registriert.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Passkeys / WebAuthn ─────────────────────────────────────────────────────
# REQUIRED, wenn Passkeys aktiv – Werte MÜSSEN zur Produktivdomain passen.
AUTH_WEBAUTHN_RP_NAME=VREMA
AUTH_WEBAUTHN_RP_ID=vrema.app
AUTH_WEBAUTHN_ORIGIN=https://vrema.app

# ── Super-Admin ─────────────────────────────────────────────────────────────
# REQUIRED – User-ID des Owner-Accounts (Backoffice-Zugriff in Dashboards/APIs).
SUPER_ADMIN_USER_ID=

# ── E-Mail / Resend ─────────────────────────────────────────────────────────
# REQUIRED für transaktionale Mails (Welcome, Reset, Verify, Lohnbüro).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@vrema.app

# ── Stripe (LIVE Keys in Production) ────────────────────────────────────────
# REQUIRED – ohne diese Variable bootet die App in Production NICHT.
STRIPE_SECRET_KEY=sk_live_xxx
# REQUIRED – Webhook für Plan-Updates / Affiliate-Maturation.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional – wenn true, ist eine Karte beim Signup verpflichtend.
REQUIRE_CARD_ON_SIGNUP=true
# REQUIRED – Stripe Price-IDs aller verfügbaren Pläne.
STRIPE_STARTER_MONTHLY=price_xxx
STRIPE_STARTER_YEARLY=price_xxx
STRIPE_BUSINESS_MONTHLY=price_xxx
STRIPE_BUSINESS_YEARLY=price_xxx
STRIPE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_ENTERPRISE_YEARLY=price_xxx

# ── Wetter (OpenWeatherMap) ────────────────────────────────────────────────
# REQUIRED für Launch (Planer-Wetter + Personal-Vorhersage mit Wetterbezug).
# Kostenloser Key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── Terminal (Public, kann gefahrlos im Browser landen) ─────────────────────
# Optional – falls gesetzt, lädt /terminal direkt diesen Slug ohne Auswahl.
NEXT_PUBLIC_TERMINAL_DEFAULT_SLUG=

# ── Data-Retention Cron ────────────────────────────────────────────────────
# REQUIRED – langes Random-Token, schützt den Cron-Endpunkt.
DATA_RETENTION_CRON_SECRET=replace-with-long-random-secret
# Optional – Tage bis unverifizierte Accounts entfernt werden.
DATA_RETENTION_UNVERIFIED_USER_DAYS=14
# Optional – Tage bis leere Companies entfernt werden.
DATA_RETENTION_EMPTY_COMPANY_DAYS=30
# Optional – Hard-Delete-Fenster (0 = deaktiviert).
DATA_RETENTION_WORKLOG_DAYS=0
DATA_RETENTION_VACATION_DAYS=0

# ── Absent-Cron (automatische Abwesenheits-Markierung) ─────────────────────
# Optional – falls leer, wird DATA_RETENTION_CRON_SECRET als Fallback benutzt.
ABSENT_CRON_SECRET=

# ── Affiliate-Maturation ────────────────────────────────────────────────────
# Optional – falls leer, wird DATA_RETENTION_CRON_SECRET als Fallback benutzt.
AFFILIATE_MATURATION_CRON_SECRET=
# Optional – Halte-Frist nach Stripe-Payment, bevor Provisionen auszahlbar werden.
AFFILIATE_HOLD_DAYS=30
# Optional – Adresse(n) für Admin-Benachrichtigungen über reife Auszahlungen.
AFFILIATE_ADMIN_NOTIFY_EMAIL=

# ── DB-Backup Rotation (vom externen Cron / pg_dump-Pipeline gelesen) ──────
BACKUP_DIR=/backups
BACKUP_PREFIX=vrema
BACKUP_KEEP_COUNT=7

# ── VREMA Native AI ────────────────────────────────────────────────────────
# Die Vorhersage- und Insights-Engine ist 100 % Teil des VREMA-Codes
# (TypeScript-statistisch, deterministisch, keine externen API-Calls).
# Es gibt deshalb KEINE Environment-Variablen zu setzen.
#
# Lern-Persistenz: Tabelle `AiWeights` (siehe Prisma-Schema). Sie wird
# automatisch beim Finalisieren jedes Schichtplans aktualisiert und ist
# pro Faktor in den Settings (→ KI-Audit) einsehbar und rücksetzbar.

# ── Dev-Only Toggles (in Production NIEMALS aktivieren) ────────────────────
# Erlaubt seedende Test-Templates im Debug-Endpunkt – nur Staging!
# ALLOW_DEMO_TASK_SEED=false
