# Core App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://vrema.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Auth.js
AUTH_SECRET=replace-with-long-random-secret
AUTH_TRUST_HOST=true
AUTH_URL=https://vrema.app

# OAuth (optional, if Google login is enabled)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Passkeys / WebAuthn (recommended explicit settings)
# These values must match your production domain.
AUTH_WEBAUTHN_RP_NAME=Vrema
AUTH_WEBAUTHN_RP_ID=vrema.app
AUTH_WEBAUTHN_ORIGIN=https://vrema.app

# Super Admin
SUPER_ADMIN_USER_ID=

# Email / Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@vrema.app

# Stripe (LIVE keys in production)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
REQUIRE_CARD_ON_SIGNUP=true
STRIPE_STARTER_MONTHLY=price_xxx
STRIPE_STARTER_YEARLY=price_xxx
STRIPE_BUSINESS_MONTHLY=price_xxx
STRIPE_BUSINESS_YEARLY=price_xxx
STRIPE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_ENTERPRISE_YEARLY=price_xxx

# Data Retention (automatic deletion job)
# Use a long random token for cron authentication
DATA_RETENTION_CRON_SECRET=replace-with-long-random-secret
# Unverified users older than X days are removed
DATA_RETENTION_UNVERIFIED_USER_DAYS=14
# Empty companies older than X days are removed
DATA_RETENTION_EMPTY_COMPANY_DAYS=30
# Optional hard-delete windows (0 disables automatic deletion)
DATA_RETENTION_WORKLOG_DAYS=0
DATA_RETENTION_VACATION_DAYS=0

# Absent Cron (automatic missing-shift marking)
# Fallback uses DATA_RETENTION_CRON_SECRET if not set.
ABSENT_CRON_SECRET=

# Affiliate: pending → available after hold period (cron / internal API)
# Falls back to DATA_RETENTION_CRON_SECRET if unset.
AFFILIATE_MATURATION_CRON_SECRET=
# Days to hold commission after invoice.paid (chargeback buffer), default 30
AFFILIATE_HOLD_DAYS=30
# E-Mail(s) für Admin-Hinweis, wenn neue Beträge auszahlbar sind (Resend)
AFFILIATE_ADMIN_NOTIFY_EMAIL=

# DB Backup rotation
BACKUP_DIR=/backups
BACKUP_PREFIX=vrema
BACKUP_KEEP_COUNT=7
