generator client {
  provider = "prisma-client-js"
}

// PostgreSQL speichert Text als UTF-8 (Server-Encoding). Kein separates utf8mb4 wie bei MySQL nötig.
datasource db {
  provider = "postgresql"
}

enum Plan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  COMPANY_OWNER
  MANAGER
  EMPLOYEE
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbsenceType {
  VACATION
  SICK
  OTHER
}

enum AbsenceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED // endgültig gelöst / archiviert (ohne Antwort möglich)
  RESOLVED // beantwortet – Antwort an Mitarbeiter gesendet
}

enum TicketType {
  BUG
  QUESTION
  FEATURE
  FEEDBACK
}

enum EntryStatus {
  ON_TIME
  LATE
  ABSENT
  MANUAL_ADJUSTED
}

enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateEarningStatus {
  PENDING   // bezahlt, Haltefrist läuft
  AVAILABLE // auszahlbar
  PAID      // manuell ausgezahlt
  CANCELLED // z. B. Rückerstattung (manuell)
}

enum BlogPostCategory {
  UPDATES
  TUTORIALS
  KNOWLEDGE
}

enum InviteRole {
  USER
  MANAGER
}

enum ShiftTaskItemStatus {
  PENDING
  DONE
  SKIPPED
}

enum ShiftTradeStatus {
  NONE
  OPEN
  PENDING_APPROVAL
}

model Affiliate {
  id        String   @id @default(cuid())
  code      String   @unique // Kleinbuchstaben, z. B. ?ref=kevin
  name      String
  email     String?  @unique
  passwordHash String?
  isActive  Boolean  @default(true)
  lastLoginAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  earnings  AffiliateEarning[]

  @@index([code])
}

model AffiliateEarning {
  id                  String                 @id @default(cuid())
  affiliateId       String
  companyId         String                 @unique
  stripeInvoiceId     String                 @unique
  plan                Plan                 @default(STARTER)
  invoiceAmountCents  Int
  commissionCents     Int // Fixbetrag je Plan (Starter/Business)
  currency            String                 @default("eur")
  status              AffiliateEarningStatus @default(PENDING)
  maturesAt           DateTime
  paidAt              DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@index([status, maturesAt])
}

model Company {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  plan              Plan            @default(STARTER)
  billingInterval   BillingInterval @default(MONTHLY)
  stripeCustomerId  String?         @unique
  stripeSubId       String?         @unique
  stripePaymentMethodFingerprint String? @unique
  paymentMethodVerifiedAt DateTime?
  trialEndsAt       DateTime?
  subEndsAt         DateTime?
  isActive          Boolean         @default(true)
  logoUrl           String?
  shiftCycleWeeks   Int             @default(1)
  /// PLZ für Wetter & lokaler Kontext (optional)
  locationZip       String?
  /// Ort für Wetter, falls keine PLZ (optional)
  locationCity      String?
  /// Geschätzter Wochenumsatz (EUR) für Lohnquoten-Kennzahlen – optional
  estimatedWeeklyRevenue Float?
  affiliateId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  affiliate         Affiliate?      @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateEarnings AffiliateEarning[]
  weatherCache      WeatherCache?

  users             User[]
  workLogs          WorkLog[]
  correctionRequests WorkLogCorrectionRequest[]
  vacationRequests  VacationRequest[]
  workSchedules     WorkSchedule[]
  shifts            Shift[]
  workLogAudits     WorkLogAudit[]
  inviteLinks       InviteLink[]
  tickets           Ticket[]
  absences          Absence[]
  taskTemplates     TaskTemplate[]
  shiftTaskLists    ShiftTaskList[]

  @@index([slug])
  @@index([affiliateId])
}

/// OpenWeather-Antwort pro Firma, max. alle 3h aktualisiert
model WeatherCache {
  id         String   @id @default(cuid())
  companyId  String   @unique
  queryKey   String
  payload    Json
  fetchedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

model InviteLink {
  id        String     @id @default(cuid())
  code      String     @unique
  role      InviteRole @default(USER)
  orgId     String
  expiresAt DateTime
  usedCount Int        @default(0)
  maxUses   Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org Company @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, expiresAt])
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String    @unique
  emailVerified   DateTime?
  password        String?
  name            String?
  image           String?
  role            UserRole  @default(EMPLOYEE)
  employeeNumber  String?
  /// Brutto-Stundenlohn (EUR), optional – für Lohn-Schätzung im Planer und in Berichten
  hourlyWage      Float?
  /// Optionale Rolle für Autopilot (z. B. Bar, Küche) – muss zu Schicht-Slot passen
  staffingRole    String?
  /// Planung: OUTDOOR | TERRACE für Wetter-Hinweise im Außenbereich; leer = Innen
  planningWorkArea String?
  phone           String?
  terminalPin     String?
  terminalPinHash String?
  weeklyHours     Float     @default(40)
  vacationDays    Int       @default(25)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts         Account[]
  sessions         Session[]
  authenticators   Authenticator[]
  workLogs         WorkLog[]
  correctionRequests WorkLogCorrectionRequest[] @relation("CorrectionRequester")
  reviewedCorrections WorkLogCorrectionRequest[] @relation("CorrectionReviewer")
  vacationRequests VacationRequest[]
  approvedVacations VacationRequest[] @relation("ApprovedBy")
  workSchedules    WorkSchedule[]
  shifts           Shift[]
  workLogAudits    WorkLogAudit[]
  tickets          Ticket[]
  absenceRequests  Absence[] @relation("AbsenceRequester")
  reviewedAbsences Absence[] @relation("AbsenceReviewer")
  timesheetAcknowledgments TimesheetAcknowledgment[]
  shiftTaskItemsCompleted  ShiftTaskItem[] @relation("ShiftTaskCompletedBy")

  @@index([companyId])
  @@index([email])
  @@unique([companyId, employeeNumber])
}

model TimesheetAcknowledgment {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  monthKey    String
  confirmedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([companyId, monthKey])
}

model Ticket {
  id           String       @id @default(cuid())
  userId       String
  orgId        String
  subject      String
  message      String       @db.Text
  status       TicketStatus @default(OPEN)
  type         TicketType   @default(QUESTION)
  response     String?      @db.Text
  userSeenResponseAt DateTime?
  respondedBy  String?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Company @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([userId, createdAt])
}

model Absence {
  id                      String               @id @default(cuid())
  userId                   String
  orgId                    String
  type                     AbsenceType
  start                    DateTime
  end                      DateTime
  status                   AbsenceRequestStatus @default(REQUESTED)
  reason                   String?
  sourceVacationRequestId  String?             @unique
  reviewedById             String?
  reviewedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user       User    @relation("AbsenceRequester", fields: [userId], references: [id], onDelete: Cascade)
  org        Company @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("AbsenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orgId, status, start, end])
  @@index([userId, start, end])
}

model Authenticator {
  credentialID         String
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@unique([credentialID])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkLog {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  clockIn     DateTime
  clockOut    DateTime?
  breakMins   Int       @default(0)
  isOnBreak   Boolean   @default(false)
  breakStartedAt DateTime?
  note        String?
  ipAddress   String?
  status      EntryStatus @default(ON_TIME)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  correctionRequests WorkLogCorrectionRequest[]
  audits      WorkLogAudit[]

  @@index([companyId, userId])
  @@index([companyId, clockIn])
}

model WorkLogAudit {
  id          String   @id @default(cuid())
  companyId   String
  workLogId   String?
  actorUserId String?
  action      String
  source      String   @default("app")
  reason      String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workLog WorkLog? @relation(fields: [workLogId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([workLogId])
  @@index([actorUserId])
}

model WorkLogCorrectionRequest {
  id               String                  @id @default(cuid())
  companyId        String
  userId           String
  workLogId        String?
  requestedClockIn DateTime
  requestedClockOut DateTime?
  requestedBreakMins Int                   @default(0)
  requestedNote    String?
  reason           String
  status           CorrectionRequestStatus @default(PENDING)
  reviewedById     String?
  reviewerNote     String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("CorrectionRequester", fields: [userId], references: [id], onDelete: Cascade)
  workLog   WorkLog? @relation(fields: [workLogId], references: [id], onDelete: SetNull)
  reviewedBy User?  @relation("CorrectionReviewer", fields: [reviewedById], references: [id])

  @@index([companyId, status])
  @@index([companyId, userId])
}

model Shift {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  dayOfWeek Int      // 0=Sun, 1=Mon ... 6=Sat
  weekIndex Int      @default(1) // 1..3 within configured cycle
  startTime String   // "08:00"
  endTime   String   // "17:00"
  breakDuration Int  @default(0) // Minuten
  /// Autopilot-Entwurf: erst nach Bestätigung wirksam
  isDraft   Boolean  @default(false)
  /// Anforderung aus Slot (Personalmangel-Report); optional
  staffingRole String?
  isOpenForTrade Boolean @default(false)
  tradeStatus ShiftTradeStatus @default(NONE)
  tradeRequestedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftTaskLists ShiftTaskList[]

  @@unique([companyId, userId, weekIndex, dayOfWeek, startTime])
  @@index([companyId, dayOfWeek])
  @@index([companyId, userId])
}

model TaskTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          TaskTemplateItem[]
  shiftTaskLists ShiftTaskList[]

  @@index([companyId])
  @@index([companyId, isDefault])
}

model TaskTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  title      String
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

/// Checklisten-Vorkommen für eine konkrete Schicht an einem Kalendertag (Europe/Berlin Mitternacht als UTC-Instant in occurrenceDate).
model ShiftTaskList {
  id             String   @id @default(cuid())
  companyId      String
  shiftId        String
  taskTemplateId String?
  occurrenceDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift    Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  template TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  items    ShiftTaskItem[]

  @@unique([shiftId, occurrenceDate])
  @@index([companyId, occurrenceDate])
}

model ShiftTaskItem {
  id                String              @id @default(cuid())
  shiftTaskListId   String
  title             String
  sortOrder         Int                 @default(0)
  isRequired        Boolean             @default(true)
  status            ShiftTaskItemStatus @default(PENDING)
  completedAt       DateTime?
  completedByUserId String?

  list        ShiftTaskList @relation(fields: [shiftTaskListId], references: [id], onDelete: Cascade)
  completedBy User?         @relation("ShiftTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([shiftTaskListId, sortOrder])
}

model WorkSchedule {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  dayOfWeek   Int      // 0=Sun, 1=Mon ... 6=Sat
  startTime   String   // "08:00"
  endTime     String   // "17:00"
  breakMins   Int      @default(30)
  isWorkDay   Boolean  @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, dayOfWeek])
  @@index([companyId])
}

model VacationRequest {
  id          String         @id @default(cuid())
  companyId   String
  userId      String
  absenceType AbsenceType    @default(VACATION)
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      VacationStatus @default(PENDING)
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([companyId, userId])
  @@index([companyId, status])
  @@index([companyId, startDate])
  @@index([companyId, endDate])
}

model BlogPost {
  id         String           @id @default(cuid())
  slug       String           @unique
  title      String
  teaser     String           @db.Text
  content    String           @db.Text
  category   BlogPostCategory
  youtubeId  String?
  published  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([published, createdAt])
  @@index([category])
}
