generator client {
  provider = "prisma-client-js"
}

// PostgreSQL speichert Text als UTF-8 (Server-Encoding). Kein separates utf8mb4 wie bei MySQL nötig.
datasource db {
  provider = "postgresql"
}

enum Plan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  COMPANY_OWNER
  MANAGER
  EMPLOYEE
  /// Externer Berater: nur Umsatz & Stoß-Profil (kein Personal, keine Löhne).
  ADVISOR
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbsenceType {
  VACATION
  SICK
  OTHER
}

enum AbsenceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED // endgültig gelöst / archiviert (ohne Antwort möglich)
  RESOLVED // beantwortet – Antwort an Mitarbeiter gesendet
}

enum TicketType {
  BUG
  QUESTION
  FEATURE
  FEEDBACK
}

enum EntryStatus {
  ON_TIME
  LATE
  ABSENT
  MANUAL_ADJUSTED
}

enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateEarningStatus {
  PENDING   // bezahlt, Haltefrist läuft
  AVAILABLE // auszahlbar
  PAID      // manuell ausgezahlt
  CANCELLED // z. B. Rückerstattung (manuell)
}

enum BlogPostCategory {
  UPDATES
  TUTORIALS
  KNOWLEDGE
}

enum InviteRole {
  USER
  MANAGER
  ADVISOR
}

enum ShiftTaskItemStatus {
  PENDING
  DONE
  SKIPPED
}

enum ShiftTradeStatus {
  NONE
  OPEN
  PENDING_APPROVAL
}

/// VREMA Native AI: Telemetrie zwischen Vorschlag und Realität.
///   - `kind` beschreibt, was wir tracken (z. B. shift_plan_deviation, staffing_recommendation)
///   - `suggestion` = was VREMA empfohlen hat (JSON-Snapshot)
///   - `actual`     = was tatsächlich passiert ist (JSON-Snapshot)
///   - `metrics`    = berechnete Abweichung (rmse, deltaPct, …) für späteres Fine-Tuning
///
/// WICHTIG: NICHTS Personenbezogenes (Namen, E-Mail) im JSON.
/// Nur IDs und aggregierte Zahlen. DSGVO-Art-32-konform.
enum AiTelemetryKind {
  SHIFT_PLAN_DEVIATION
  STAFFING_RECOMMENDATION
  COMPLIANCE_SCORE
  NO_SHOW_PREDICTION
  GENERIC
}

model AiTelemetry {
  id          String           @id @default(cuid())
  companyId   String
  kind        AiTelemetryKind
  /// JSON-Snapshot des Modell-/Heuristik-Vorschlags
  suggestion  Json
  /// JSON-Snapshot der tatsächlichen Realität (kann null sein, bis Realität bekannt ist)
  actual      Json?
  /// Berechnete Abweichung – Schlüssel z. B. "rmse", "deltaPct", "matched"
  metrics     Json?
  /// Engine-Tag, der den Vorschlag erzeugt hat ("native-core-v1", "heuristic-v2", …)
  modelTag    String
  /// Bezugs-Datum, falls der Vorschlag tagesbezogen war (z. B. KW-Tag)
  referenceDate DateTime?
  createdAt   DateTime         @default(now())
  closedAt    DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, kind, createdAt])
  @@index([companyId, referenceDate])
}

/// VREMA Native Core AI: gelernte Korrekturfaktoren pro Tenant.
/// Keine Texte, kein LLM – ausschließlich numerische Multiplikatoren.
/// dimension = Klasse des Faktors (z. B. "history_weekday", "weather", "event", "experience"),
/// key       = konkreter Bucket (z. B. "MON", "RAIN", "PUBLIC_HOLIDAY_EVE", "JUNIOR_HEAVY").
/// weight    ∈ [0.3 .. 3.0], Default 1.0 (= keine Korrektur).
model AiWeights {
  id          String   @id @default(cuid())
  companyId   String
  dimension   String
  key         String
  weight      Float    @default(1.0)
  /// Anzahl der Lernzyklen, die in diesen Faktor eingeflossen sind.
  sampleCount Int      @default(0)
  /// Letzte beobachtete Abweichung (actual/predicted - 1). Nur Diagnose.
  lastError   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, dimension, key])
  @@index([companyId, dimension])
}

/// Betriebs-Kategorie – steuert Predictive- und AI-Heuristiken.
enum CompanyIndustry {
  RESTAURANT
  CAFE
  BAR
  HOTEL
  BAKERY
  CANTEEN
  CLUB
  CATERING
  OTHER
}

/// In-App-Notifications (Light-Push). Werden beim Öffnen der App angezeigt — kein OS-Push nötig.
enum NotificationType {
  VACATION_APPROVED
  VACATION_REJECTED
  SHIFT_PUBLISHED
  SHIFT_TRADE_APPROVED
  SHIFT_TRADE_REJECTED
  CORRECTION_APPROVED
  CORRECTION_REJECTED
  GENERIC
}

model Affiliate {
  id        String   @id @default(cuid())
  code      String   @unique // Kleinbuchstaben, z. B. ?ref=kevin
  name      String
  email     String?  @unique
  passwordHash String?
  isActive  Boolean  @default(true)
  lastLoginAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  earnings  AffiliateEarning[]

  @@index([code])
}

model AffiliateEarning {
  id                  String                 @id @default(cuid())
  affiliateId       String
  companyId         String                 @unique
  stripeInvoiceId     String                 @unique
  plan                Plan                 @default(STARTER)
  invoiceAmountCents  Int
  commissionCents     Int // Fixbetrag je Plan (Starter/Business)
  currency            String                 @default("eur")
  status              AffiliateEarningStatus @default(PENDING)
  maturesAt           DateTime
  paidAt              DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@index([status, maturesAt])
}

model Company {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  plan              Plan            @default(STARTER)
  billingInterval   BillingInterval @default(MONTHLY)
  stripeCustomerId  String?         @unique
  stripeSubId       String?         @unique
  stripePaymentMethodFingerprint String? @unique
  paymentMethodVerifiedAt DateTime?
  trialEndsAt       DateTime?
  subEndsAt         DateTime?
  isActive          Boolean         @default(true)
  logoUrl           String?
  shiftCycleWeeks   Int             @default(1)
  /// PLZ für Wetter & lokaler Kontext (optional)
  locationZip       String?
  /// Ort für Wetter, falls keine PLZ (optional)
  locationCity      String?
  /// Branche / Betriebskategorie – steuert Predictive-Heuristiken (Café-Spitzen morgens,
  /// Bar-Spitzen Fr/Sa abends, Hotel = stetige Auslastung, …). Optional.
  industry          CompanyIndustry?
  /// Bundesland-Code (ISO 3166-2:DE, z. B. "DE-BE"). Wichtig für Feiertage in der Vorhersage.
  region            String?
  /// Geschätzter Wochenumsatz (EUR) für Lohnquoten-Kennzahlen – optional
  estimatedWeeklyRevenue Float?
  /// Stoß-Profil Mo–So: LOW | NORMAL | HIGH (Index 0 = Montag)
  peakDayLevels       String[] @default(["NORMAL", "NORMAL", "NORMAL", "NORMAL", "NORMAL", "NORMAL", "NORMAL"])
  affiliateId       String?
  // ── Enterprise: Custom Branding ──────────────────────────────────────────
  /// Hex-Farbe (#RRGGBB), die als Brand-Akzent im Light-Mode genutzt wird.
  /// Wenn null → VREMA-Default (#0a3a52 Petrol).
  brandColor        String?
  /// Hex-Farbe für Dark-Mode (helle Variante). Wenn null → automatische Light-Variante des Brand-Colors.
  brandColorDark    String?
  // ── Enterprise: Privacy-First Clocking via IP-Allowlist ──────────────────
  /// Wenn true, prüft `/clock-in` & Terminal-Auth die IP-Adresse der Anfrage gegen `clockIpAllowlist`.
  clockIpRestrictionEnabled Boolean @default(false)
  /// CIDR-Blöcke oder Plain-IPs (IPv4/IPv6). Beispiel: ["203.0.113.0/24", "2001:db8::/32", "198.51.100.42"]
  clockIpAllowlist  String[] @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  affiliate         Affiliate?      @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateEarnings AffiliateEarning[]
  weatherCache      WeatherCache?

  users             User[]
  workLogs          WorkLog[]
  correctionRequests WorkLogCorrectionRequest[]
  vacationRequests  VacationRequest[]
  workSchedules     WorkSchedule[]
  shifts            Shift[]
  workLogAudits     WorkLogAudit[]
  inviteLinks       InviteLink[]
  tickets           Ticket[]
  absences          Absence[]
  taskTemplates     TaskTemplate[]
  shiftTemplates    ShiftTemplate[]
  shiftTaskLists    ShiftTaskList[]
  notifications     Notification[]
  apiKeys           ApiKey[]
  aiTelemetry       AiTelemetry[]
  aiWeights         AiWeights[]

  @@index([slug])
  @@index([affiliateId])
}

/// Externer API-Key für `/api/v1/external/*`. Klartext wird ausschließlich
/// beim Erstellen an den Owner zurückgegeben; in der DB liegt nur ein SHA-256-Hash.
model ApiKey {
  id          String   @id @default(cuid())
  companyId   String
  /// Sprechender Name z.B. "Buchhaltungs-Software" – nur für UI.
  name        String
  /// SHA-256(klartext-key) – deterministisch, daher Index-fähig fürs O(1)-Lookup.
  hashedKey   String   @unique
  /// Letzte 4 Zeichen des Klartext-Keys als Wiedererkennungs-Hinweis.
  keyHint     String
  /// Erlaubte Scopes (Future-proof, aktuell: ["status:read"]).
  scopes      String[] @default([])
  isActive    Boolean  @default(true)
  /// User-ID des Owners, der den Key angelegt hat (für Audit).
  createdById String?
  createdAt   DateTime @default(now())
  /// Wann zuletzt verwendet (Heartbeat fürs Audit-Dashboard).
  lastUsedAt  DateTime?
  /// Optional: harter Ablaufzeitpunkt (Rotation/Compliance).
  expiresAt   DateTime?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([hashedKey])
  @@index([expiresAt])
}

/// OpenWeather-Antwort pro Firma, max. alle 3h aktualisiert
model WeatherCache {
  id         String   @id @default(cuid())
  companyId  String   @unique
  queryKey   String
  payload    Json
  fetchedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

model InviteLink {
  id        String     @id @default(cuid())
  code      String     @unique
  role      InviteRole @default(USER)
  orgId     String
  expiresAt DateTime
  usedCount Int        @default(0)
  maxUses   Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org Company @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, expiresAt])
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String    @unique
  emailVerified   DateTime?
  password        String?
  name            String?
  image           String?
  role            UserRole  @default(EMPLOYEE)
  employeeNumber  String?
  /// Brutto-Stundenlohn (EUR), optional – für Lohn-Schätzung im Planer und in Berichten
  hourlyWage      Float?
  /// Optionale Rolle für Autopilot (z. B. Bar, Küche) – muss zu Schicht-Slot passen
  staffingRole    String?
  /// Planung: OUTDOOR | TERRACE für Wetter-Hinweise im Außenbereich; leer = Innen
  planningWorkArea String?
  phone           String?
  terminalPin     String?
  terminalPinHash String?
  weeklyHours     Float     @default(40)
  vacationDays    Int       @default(25)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts         Account[]
  sessions         Session[]
  authenticators   Authenticator[]
  workLogs         WorkLog[]
  correctionRequests WorkLogCorrectionRequest[] @relation("CorrectionRequester")
  reviewedCorrections WorkLogCorrectionRequest[] @relation("CorrectionReviewer")
  vacationRequests VacationRequest[]
  approvedVacations VacationRequest[] @relation("ApprovedBy")
  workSchedules    WorkSchedule[]
  shifts           Shift[]
  workLogAudits    WorkLogAudit[]
  tickets          Ticket[]
  absenceRequests  Absence[] @relation("AbsenceRequester")
  reviewedAbsences Absence[] @relation("AbsenceReviewer")
  timesheetAcknowledgments TimesheetAcknowledgment[]
  shiftTaskItemsCompleted  ShiftTaskItem[] @relation("ShiftTaskCompletedBy")
  notifications            Notification[]

  @@index([companyId])
  @@index([email])
  @@unique([companyId, employeeNumber])
}

/// Personal-Notification: gehört genau einem Empfänger (User), tenant-isoliert via companyId.
model Notification {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  type      NotificationType @default(GENERIC)
  title     String
  body      String?
  /// Optionaler Deep-Link in die App (z. B. /dashboard/vacation)
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, createdAt])
  @@index([userId, readAt])
}

model TimesheetAcknowledgment {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  monthKey    String
  confirmedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@index([companyId, monthKey])
}

model Ticket {
  id           String       @id @default(cuid())
  userId       String
  orgId        String
  subject      String
  message      String       @db.Text
  status       TicketStatus @default(OPEN)
  type         TicketType   @default(QUESTION)
  response     String?      @db.Text
  userSeenResponseAt DateTime?
  respondedBy  String?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Company @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([userId, createdAt])
}

model Absence {
  id                      String               @id @default(cuid())
  userId                   String
  orgId                    String
  type                     AbsenceType
  start                    DateTime
  end                      DateTime
  status                   AbsenceRequestStatus @default(REQUESTED)
  reason                   String?
  sourceVacationRequestId  String?             @unique
  reviewedById             String?
  reviewedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user       User    @relation("AbsenceRequester", fields: [userId], references: [id], onDelete: Cascade)
  org        Company @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("AbsenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orgId, status, start, end])
  @@index([userId, start, end])
}

model Authenticator {
  credentialID         String
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@unique([credentialID])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkLog {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  clockIn     DateTime
  clockOut    DateTime?
  breakMins   Int       @default(0)
  isOnBreak   Boolean   @default(false)
  breakStartedAt DateTime?
  note        String?
  ipAddress   String?
  status      EntryStatus @default(ON_TIME)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  correctionRequests WorkLogCorrectionRequest[]
  audits      WorkLogAudit[]

  @@index([companyId, userId])
  @@index([companyId, clockIn])
  // Hot-Paths Dashboard: (a) aktive Stempelung suchen, (b) Tages-/Monats-Range pro User
  @@index([companyId, userId, clockIn])
  @@index([companyId, userId, clockOut])
}

model WorkLogAudit {
  id          String   @id @default(cuid())
  companyId   String
  workLogId   String?
  actorUserId String?
  action      String
  source      String   @default("app")
  reason      String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workLog WorkLog? @relation(fields: [workLogId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([workLogId])
  @@index([actorUserId])
}

model WorkLogCorrectionRequest {
  id               String                  @id @default(cuid())
  companyId        String
  userId           String
  workLogId        String?
  requestedClockIn DateTime
  requestedClockOut DateTime?
  requestedBreakMins Int                   @default(0)
  requestedNote    String?
  reason           String
  status           CorrectionRequestStatus @default(PENDING)
  reviewedById     String?
  reviewerNote     String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("CorrectionRequester", fields: [userId], references: [id], onDelete: Cascade)
  workLog   WorkLog? @relation(fields: [workLogId], references: [id], onDelete: SetNull)
  reviewedBy User?  @relation("CorrectionReviewer", fields: [reviewedById], references: [id])

  @@index([companyId, status])
  @@index([companyId, userId])
}

model Shift {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  dayOfWeek Int      // 0=Sun, 1=Mon ... 6=Sat
  weekIndex Int      @default(1) // 1..3 within configured cycle
  startTime String   // "08:00"
  endTime   String   // "17:00"
  breakDuration Int  @default(0) // Minuten
  /// Autopilot-Entwurf: erst nach Bestätigung wirksam
  isDraft   Boolean  @default(false)
  /// Anforderung aus Slot (Personalmangel-Report); optional
  staffingRole String?
  isOpenForTrade Boolean @default(false)
  tradeStatus ShiftTradeStatus @default(NONE)
  tradeRequestedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftTaskLists ShiftTaskList[]

  @@unique([companyId, userId, weekIndex, dayOfWeek, startTime])
  @@index([companyId, dayOfWeek])
  @@index([companyId, userId])
  // findNextShift / queryActiveShiftTasks / Reports „shifts pro User in Woche/Tag"
  @@index([companyId, userId, isDraft, dayOfWeek])
  @@index([companyId, tradeStatus])
}

/// Wiederverwendbare Schicht-Vorlagen für den Planer (z. B. Frühschicht 08:00–16:00).
model ShiftTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  startTime String
  endTime   String
  /// Optional: Hex-Akzent (#RRGGBB) für Karten im Schichtplan
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
}

model TaskTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Optional: gleicher Schlüssel wie User.staffingRole / Shift.staffingRole (z. B. „Küche“, „Bar“).
  staffingRole String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          TaskTemplateItem[]
  shiftTaskLists ShiftTaskList[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@index([companyId, staffingRole])
}

model TaskTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  title      String
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

/// Checklisten-Vorkommen für eine konkrete Schicht an einem Kalendertag (Europe/Berlin Mitternacht als UTC-Instant in occurrenceDate).
model ShiftTaskList {
  id             String   @id @default(cuid())
  companyId      String
  shiftId        String
  taskTemplateId String?
  occurrenceDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift    Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  template TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)
  items    ShiftTaskItem[]

  @@unique([shiftId, occurrenceDate])
  @@index([companyId, occurrenceDate])
}

model ShiftTaskItem {
  id                String              @id @default(cuid())
  shiftTaskListId   String
  title             String
  sortOrder         Int                 @default(0)
  isRequired        Boolean             @default(true)
  status            ShiftTaskItemStatus @default(PENDING)
  completedAt       DateTime?
  completedByUserId String?

  list        ShiftTaskList @relation(fields: [shiftTaskListId], references: [id], onDelete: Cascade)
  completedBy User?         @relation("ShiftTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([shiftTaskListId, sortOrder])
}

model WorkSchedule {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  dayOfWeek   Int      // 0=Sun, 1=Mon ... 6=Sat
  startTime   String   // "08:00"
  endTime     String   // "17:00"
  breakMins   Int      @default(30)
  isWorkDay   Boolean  @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, dayOfWeek])
  @@index([companyId])
}

model VacationRequest {
  id          String         @id @default(cuid())
  companyId   String
  userId      String
  absenceType AbsenceType    @default(VACATION)
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  /// Vom Genehmiger gespeicherte Anmerkung/Begründung (erscheint ggf. in E-Mail & UI-Historie).
  decisionNote String?        @db.Text
  status      VacationStatus @default(PENDING)
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([companyId, userId])
  @@index([companyId, status])
  @@index([companyId, startDate])
  @@index([companyId, endDate])
}

model BlogPost {
  id         String           @id @default(cuid())
  slug       String           @unique
  title      String
  teaser     String           @db.Text
  content    String           @db.Text
  category   BlogPostCategory
  youtubeId  String?
  published  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([published, createdAt])
  @@index([category])
}
